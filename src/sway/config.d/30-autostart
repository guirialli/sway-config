
exec waybar
# Agente de Autenticacao Polkit para janelas graficas de senha (root / pkexec)
exec --no-startup-id ~/.config/sway/scripts/polkit-runner.sh &


#Applets
exec blueman-applet &
exec mako &
exec nm-applet --indicator &
exec $sway-manager idle toggle -s 
exec wl-paste --watch cliphist store

# Portals
exec --no-startup-id /usr/lib/xdg-desktop-portal-wlr & 
exec --no-startup-id /usr/lib/xdg-desktop-portal-gtk & 
exec --no-startup-id /usr/lib/xdg-desktop-portal &
exec --no-startup-id ~/.config/sway/scripts/monitor-swap.py -d & 

# Applications
exec ulauncher
exec autotiling


#Keyring
exec --no-startup-id gnome-keyring-daemon --start --components=gpg,pkcs11,secrets,ssh
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP QT_QPA_PLATFORMTHEME


# Autoriza root a exibir janelas graficas via Polkit/pkexec (ex: btrfs-assistant)
exec xhost +si:localuser:root &

exec gammastep -l -13.85:-40.08 -t 6500:3500
